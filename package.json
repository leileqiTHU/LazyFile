{
  "name": "lazyfile",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Find files by meaning, exact words, or an assistant that searches and reads your folders.",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "pnpm build && electron-builder --config electron-builder.config.cjs --dir",
    "dist:win": "pnpm build && electron-builder --config electron-builder.config.cjs --win nsis",
    "dist:mac": "pnpm build && electron-builder --config electron-builder.config.cjs --mac dmg"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "js-tiktoken": "1.0.21",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "license": "MIT",
  "author": "Leis",
  "repository": {
    "type": "git",
    "url": "https://github.com/leileqiTHU/LazyFile.git"
  }
}
